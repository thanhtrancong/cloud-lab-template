cat > ~/.lab07.env <<'EOF'
# Replace the values below with your own
export DOMAIN="vlsc07-nguyenvana.site"
export FQDN="api.${DOMAIN}"
export STUDENT_ID="2021001"
export ORIGIN_HOST="vlsc07-api.onrender.com"
export ASSET="lab07-proof.css"
EOF

# Load the variables into the current terminal session
source ~/.lab07.env

# Verify the variables are loaded correctly
echo "DOMAIN=$DOMAIN FQDN=$FQDN ORIGIN_HOST=$ORIGIN_HOST STUDENT_ID=$STUDENT_ID"